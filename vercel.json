{
  "version": 2,
  "builds": [
    { "src": "api/upload.js", "use": "@vercel/node" },
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "qrcode.min.js", "use": "@vercel/static" },
    { "src": "html5-qrcode.min.js", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/upload.js" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
